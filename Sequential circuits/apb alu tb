module tb;

reg pclk;
reg prst;
reg transfer;
reg pread_or_write;
reg [7:0] apb_write_addr;
reg [7:0] apb_read_addr;
reg [7:0] apb_write_data;

wire [7:0] apb_read_data;

top dut(
    .pclk(pclk),
    .prst(prst),
    .transfer(transfer),
    .pread_or_write(pread_or_write),
    .apb_write_addr(apb_write_addr),
    .apb_read_addr(apb_read_addr),
    .apb_write_data(apb_write_data),
    .apb_read_data(apb_read_data)
);

initial
begin
    pclk = 0;
    forever #5 pclk = ~pclk;
end

initial
begin
    prst = 1;
    transfer = 0;
    pread_or_write = 0;
    apb_write_addr = 0;
    apb_read_addr = 0;
    apb_write_data = 0;

    #20;
    prst = 0;

    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h00;
    apb_write_data = 8'd15;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h01;
    apb_write_data = 8'd5;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h02;
  apb_write_data = 8'b00;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 0;
    apb_read_addr = 8'h03;

    #20;
    transfer = 0;

    #20;
    $display("ADD RESULT = %d", apb_read_data);

    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h02;
    apb_write_data = 8'b01;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 0;
    apb_read_addr = 8'h03;

    #20;
    transfer = 0;

    #20;
    $display("SUB RESULT = %d", apb_read_data);

  
    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h02;
    apb_write_data = 8'b10;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 0;
    apb_read_addr = 8'h03;

    #20;
    transfer = 0;

    #20;
    $display("AND RESULT = %d", apb_read_data);

    #10;
    transfer = 1;
    pread_or_write = 1;
    apb_write_addr = 8'h02;
    apb_write_data = 8'b11;

    #20;
    transfer = 0;

    #10;
    transfer = 1;
    pread_or_write = 0;
    apb_read_addr = 8'h03;

    #20;
    transfer = 0;

    #20;
    $display("OR RESULT = %d", apb_read_data);

    #20;
    $finish;
end

endmodule
