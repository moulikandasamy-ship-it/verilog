
module tb_apb_alu;

    reg    PCLK;
    reg     PRESETn;

    reg     PSEL;
    reg    PENABLE;
    reg    PWRITE;
    reg [7:0]   PADDR;
    reg [31:0]  PWDATA;

    wire [31:0] PRDATA;
    wire  PREADY;
    wire   PSLVERR;

    
    apb_alu dut (
        .PCLK(PCLK),
        .PRESETn(PRESETn),
        .PSEL(PSEL),
        .PENABLE(PENABLE),
        .PWRITE(PWRITE),
        .PADDR(PADDR),
        .PWDATA(PWDATA),
        .PRDATA(PRDATA),
        .PREADY(PREADY),
        .PSLVERR(PSLVERR)
    );

    initial begin
        PCLK = 0;
        forever #5 PCLK = ~PCLK;
    end

    task apb_write;
        input [7:0] addr;
        input [31:0] data;

        begin
            @(posedge PCLK);

            PSEL    <= 1'b1;
            PENABLE <= 1'b0;
            PWRITE  <= 1'b1;
            PADDR   <= addr;
            PWDATA  <= data;

            @(posedge PCLK);

            PENABLE <= 1'b1;

            @(posedge PCLK);

            PSEL    <= 1'b0;
            PENABLE <= 1'b0;
            PWRITE  <= 1'b0;
        end
    endtask

    task apb_read;
        input  [7:0] addr;

        begin
            @(posedge PCLK);

            PSEL    <= 1'b1;
            PENABLE <= 1'b0;
            PWRITE  <= 1'b0;
            PADDR   <= addr;

            @(posedge PCLK);

            PENABLE <= 1'b1;

            @(posedge PCLK);

            $display("READ ADDR = %h DATA = %h", addr, PRDATA);

            PSEL    <= 1'b0;
            PENABLE <= 1'b0;
        end
    endtask

    initial begin

        PSEL    = 0;
        PENABLE = 0;
        PWRITE  = 0;
        PADDR   = 0;
        PWDATA  = 0;

        PRESETn = 0;

        #20;
        PRESETn = 1;

        apb_write(8'h00, 32'd20); 
        apb_write(8'h04, 32'd10);
        apb_write(8'h08, 32'd0); 

        apb_read(8'h0C);

        apb_write(8'h08, 32'd1);

        apb_read(8'h0C);

        apb_write(8'h08, 32'd2);

        apb_read(8'h0C);

        apb_write(8'h08, 32'd3);

        apb_read(8'h0C);

        #50;
        $finish;
    end

endmodule
