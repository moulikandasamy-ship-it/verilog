module top_module(
    input clk,
    input areset,    // Freshly brainwashed Lemmings walk left.
    input bump_left,
    input bump_right,
    input ground,
    input dig,
    output walk_left,
    output walk_right,
    output aaah,
    output digging ); 
    
     parameter left=0,right=1,fall_left=2,fall_right=3,digg_left=4,digg_right=5;
    reg[2:0] state, next_state;

    always @(*) begin
        case(state)
            left:begin
                next_state=(!ground)?fall_left:(dig)?digg_left:(bump_left)?right:left;
            end
            right:begin
                next_state=(!ground)?fall_right:(dig)?digg_right:(bump_right)?left:right;
            end
            fall_left:begin
                next_state=(ground)?left:fall_left;
            end
            fall_right:begin
                next_state=(ground)?right:fall_right;
            end
            digg_left:begin
                next_state=(ground)?digg_left:fall_left;
            end
            digg_right:begin
                next_state=(ground)?digg_right:fall_right;
            end
            
            default:next_state=2'bxx;
            
        endcase
    end
    
    

    always @(posedge clk, posedge areset) begin
        if(areset)
            state<=left;
        else
            state<=next_state;
    end

    assign walk_left = (state == left);
    assign walk_right = (state == right);
    assign aaah=(state==fall_left)|(state==fall_right);
    assign digging=(state==digg_left)|(state==digg_right);
endmodule



